# Copy to .env for local use. These values are development-only placeholders.
POSTGRES_PASSWORD=local-postgres-change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-change-me
KEYCLOAK_PAYMENT_CLIENT_SECRET=local-payment-client-change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-change-me
OPENAI_API_KEY=
VITE_DEMO_MODE=false
VITE_KEYCLOAK_URL=http://localhost:8088
VITE_KEYCLOAK_REALM=paynexus
VITE_KEYCLOAK_CLIENT_ID=paynexus-web
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost,http://localhost:*,http://127.0.0.1:*
TRACING_SAMPLING_PROBABILITY=1.0
RECONCILIATION_INTERVAL=PT5M
RECONCILIATION_STALE_THRESHOLD=PT30M
